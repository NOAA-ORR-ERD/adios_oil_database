<div class="col pl-0">
  <div class="row">
    <div class="col pl-0">
      <strong>
        Review Status:
      </strong>
      <BsButton @type={{this.reviewStatusProperties.buttonType}}
                class="m-1 btn-sm text-nowrap"
                disabled={{not @editable}}
                @onClick={{this.show_dialog}} >
        <strong>
          {{@oil.review_status.status}}
        </strong>
      </BsButton>
    </div>
  </div>

  <Textarea
    class="p-1 reference-textarea overflow-auto bg-transparent border"
    @value={{@oil.review_status.notes}}
    placeholder="No Notes"
    title="Review Status Notes"
    rows="2"
    disabled={{true}}
  />
</div>

{{#if this.dialogVisible}}
  <Dialog::ReviewStatus
    @oil={{@oil}}
    @close={{this.close_dialog}}
    @submit={{this.submit}}
  />
{{/if}}

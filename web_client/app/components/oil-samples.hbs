<BsTab
  @customTabs={{true}}
  @activeId={{this.sampleTab}}
  @onChange={{this.onChangeTab}}
  as |tab|>

  {{! First we render our tab navigation items }}
  <BsNav @type="tabs" role="tablist" as |nav|>
    {{#each this.subsampleNavTabProperties as |props idx|}}
      <nav.item @active={{eq tab.activeId props.id }} role="presentation">
        {{#if (eq tab.activeId props.id) }}
          <a role="tab" class="nav-link active" aria-selected="{{eq tab.activeId props.id }}"
            href={{props.href}}
            onclick={{fn tab.select props.id}}
           >
          {{props.short_name}}
          </a>
        {{else}}
          <a role="tab" class="nav-link" aria-selected="{{eq tab.activeId props.id }}"
            href={{props.href}}
            onclick={{fn tab.select props.id}}
           >
          {{props.short_name}}
          </a>
        {{/if}}
      </nav.item>
    {{/each}}

    {{! The "extra" tabs are associated to the oil, }}
    {{! but are not subsample data (e.g. attachments) }}
    {{#each this.extraNavTabProperties as |props idx|}}
      <nav.item @active={{eq tab.activeId props.id }} role="presentation">
        {{#if (eq tab.activeId props.id) }}
          <a role="tab" class="nav-link active" aria-selected="{{eq tab.activeId props.id }}"
            href={{props.href}}
            onclick={{fn tab.select props.id}}
           >
          {{props.short_name}}
          </a>
        {{else}}
          <a role="tab" class="nav-link" aria-selected="{{eq tab.activeId props.id }}"
            href={{props.href}}
            onclick={{fn tab.select props.id}}
           >
          {{props.short_name}}
          </a>
        {{/if}}
      </nav.item>
    {{/each}}
    
    {{#if @editable}}
      <TabNav::AddSample
        @oil={{@oil}}
        @submit={{@submit}}
      />
    {{/if}}

  </BsNav>

  {{! Now we render our tab panes }}
  <div class="tab-content">
    {{#each this.subsampleTabPaneProperties as |props idx|}}
      <tab.pane @id={{props.id}} @title={{props.short_name}} >

        <TabPane::SubSample
          @oil={{@oil}}
          @store={{@oil.store}}
          @webApi={{@webApi}}
          @editable={{@editable}}
          @submit={{@submit}}
          @sampleTab={{@sampleTab}}
          @categoryTab={{@categoryTab}}
          @updateCategoryTab={{@updateCategoryTab}}
          @updateSampleTab={{@updateSampleTab}}
          @sampleName={{props.short_name}}
          @sampleIndex={{idx}}
          @distillationTypes={{@distillationTypes}}
        />

      </tab.pane>
    {{/each}}

    {{! The "extra" tab panes are tab panes associated to the oil, }}
    {{! but are not subsample data (e.g. attachments) }}
    {{#each this.extraTabPaneProperties as |props|}}
      <tab.pane @id={{props.id}} @title={{props.label}}>
        {{component props.componentName
          oil=@oil
          store=@store
          webApi=@webApi
          editable=@editable}}
      </tab.pane>
    {{/each}}

  </div>
</BsTab>

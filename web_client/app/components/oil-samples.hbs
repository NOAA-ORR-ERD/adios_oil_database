<BsTab @customTabs={{true}} as |tab|>

  {{! First we render our tab navigation items }}
  <BsNav @type="tabs" role="tablist" as |nav|>
    {{#each this.navTabProperties as |props idx|}}
      <nav.item @active={{eq tab.activeId props.id }} role="presentation">
        {{#if (eq tab.activeId props.id) }}
          <a role="tab" class="nav-link active" aria-selected="{{eq tab.activeId props.id }}"
            href={{props.href}}
            onclick={{action tab.select props.id}}
           >
            {{#if @editable}}
              <Input
                @class="p-1 overflow-hidden bg-transparent border"
                @value={{props.short_name}}
                @change={{action "updateShortSampleName" idx}}
              />
              {{#if idx}}
                {{! We don't want to remove sample 0 (Fresh Oil) }}
                <TabNav::RemoveSample
                  @oil={{@oil}}
                  @index={{idx}}
                  @submit={{@submit}}
                />
              {{/if}}
            {{else}}
              {{props.short_name}}
            {{/if}}
          </a>
        {{else}}
          <a role="tab" class="nav-link" aria-selected="{{eq tab.activeId props.id }}"
            href={{props.href}}
            onclick={{action tab.select props.id}}
           >
            {{#if @editable}}
              <Input
                @class="p-1 overflow-hidden bg-transparent border"
                @value={{props.short_name}}
                @change={{action "updateShortSampleName" idx}}
              />
              {{#if idx}}
                {{! We don't want to remove sample 0 (Fresh Oil) }}
                <TabNav::RemoveSample
                  @oil={{@oil}}
                  @index={{idx}}
                  @submit={{@submit}}
                />
              {{/if}}
            {{else}}
              {{props.short_name}}
            {{/if}}
          </a>
        {{/if}}
      </nav.item>
    {{/each}}
    
    {{#if @editable}}
      <TabNav::AddSample
        @oil={{@oil}}
        @submit={{@submit}}
      />
    {{/if}}

  </BsNav>

  {{! Now we render our tab panes }}
  <div class="tab-content">
    {{#each this.tabPaneProperties as |props|}}
      <tab.pane @id={{props.id}} @title={{props.short_name}} >

        <TabPane::SubSample
          @oil={{@oil}}
          @store={{@oil.store}}
          @editable={{@editable}}
          @submit={{@submit}}
          @sampleTab={{@sampleTab}}
          @categoryTab={{@categoryTab}}
          @updateCategoryTab={{@updateCategoryTab}}
          @sampleName={{props.short_name}}
          @distillationTypes={{@distillationTypes}}
        />

      </tab.pane>
    {{/each}}
  </div>
</BsTab>

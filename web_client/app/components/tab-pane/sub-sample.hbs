<BsTab
  @activeId={{this.categoryTab}}
  @onChange={{this.onChangeTab}}
  as |tab|>

  {{#each this.tabPaneProperties as |props|}}
    <tab.pane @id={{props.id}} @title={{props.label}}>
      {{component props.componentName
        oil=this.sample
        oilId=this.oilId
        store=@store
        webApi=@webApi
        editable=@editable
        submit=this.submitSample
        sampleIndex=@sampleIndex
        sampleName=@sampleName
        distillationTypes=@distillationTypes
        updateSampleTab=@updateSampleTab
        updateCategoryTab=@updateCategoryTab}}
    </tab.pane>
  {{/each}}
</BsTab>

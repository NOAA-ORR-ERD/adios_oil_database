# Oil Database Web Client Docker configuration
#
#FROM registry.orr.noaa.gov/erd/centos-conda/centos7-python3.9
FROM node:lts-slim

COPY ./web_client ./web_client
RUN cd web_client && \
		npm ci && \
		npx ember build --environment ${BUILD_ENV:-development}
COPY ./docker/config/client/main.json web_client/dist/configs/

FROM nginx:alpine
WORKDIR /etc/nginx/html
COPY --from=0 /web_client/dist/ .
COPY ./docker/config/client/nginx.conf /etc/nginx/nginx.conf
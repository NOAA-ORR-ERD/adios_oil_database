# Oil Database Web API Docker configuration

ARG PYTHON_VER

# FROM registry.orr.noaa.gov/erd/centos-conda/ubuntu/ubuntuforge-python$PYTHON_VER
FROM registry.orr.noaa.gov/erd/environments/ubuntu/ubuntuforge-python$PYTHON_VER

ARG PYTHON_VER
ARG noaa_oil_data_token
ARG BRANCH_NAME='under_review'

VOLUME [ "/noaa-oil-data" ]

COPY ./web_api ./web_api
COPY ./adios_db ./adios_db
COPY ./documents ./documents
COPY ./README.md ./README.md
COPY ./user_docs ./user_docs

# install deps
# needed for cornice (for now)
RUN conda config --append channels defaults

RUN conda install -y \
    python=$PYTHON_VER \
    --file adios_db/conda_requirements.txt \
    --file web_api/conda_requirements.txt \
    --file documents/conda_requirements.txt \
    && conda clean --all

RUN cd adios_db && pip install -e ./
RUN cd web_api && pip install -e ./

# build docs
RUN cd documents \
    && sphinx-build -a -E -b html source build/html \
    && /usr/bin/cp -rf build/html/* ../user_docs \
    && /usr/bin/rm -rf build

RUN apt-get install git -y

# setup initial data repository
RUN git config --global user.email 'adios-script@noaa.gov' \
    && git config --global user.name 'ADIOS automated script' 

RUN /web_api/init_noaa_data.sh

COPY ./docker/config/api /config/

EXPOSE 9898
ENTRYPOINT ["/web_api/docker_start.sh"]
